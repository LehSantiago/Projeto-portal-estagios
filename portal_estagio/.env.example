# Copie este arquivo para ".env" (na pasta portal_estagio, onde fica o pom.xml) e preencha.
# O arquivo ".env" NUNCA deve ir para o Git (já está no .gitignore).
# Este exemplo contém apenas valores de mentira.

# PostgreSQL local (padrão):
PORTAL_DB_URL=jdbc:postgresql://localhost:5432/portal_estagios
PORTAL_DB_USER=postgres
PORTAL_DB_PASSWORD=troque_esta_senha

# Administrador de demonstração (opcional; criado na inicialização se o e-mail ainda não existir).
# A senha precisa ter 8+ caracteres, com letras e números.
PORTAL_ADMIN_EMAIL=admin@portal.local
PORTAL_ADMIN_PASSWORD=TroqueEstaSenha123
